{
  "name": "ai-annotator",
  "displayName": "AI Annotator",
  "description": "Enterprise AI Code Detection, Annotation, Tracking & Analytics Dashboard",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "ai.resetId",
        "title": "AI Annotator: Reset Employee ID"
      },
      {
        "command": "ai.showReport",
        "title": "AI Annotator: Open Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "ai.resetId" },
        { "command": "ai.showReport" }
      ]
    }
  },

  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },

  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0"
  }
}
